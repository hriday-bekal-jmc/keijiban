{
  "name": "keijiban-api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude .env --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "migrate": "tsx --env-file-if-exists=.env src/migrations/run.ts",
    "build": "tsc",
    "check:live": "tsx --env-file-if-exists=.env src/scripts/checkLiveUpdates.ts",
    "check:visibility": "tsx --env-file-if-exists=.env src/scripts/checkVisibility.ts"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "file-type": "^22.0.1",
    "google-auth-library": "^9.11.0",
    "googleapis": "^140.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^9.0.3",
    "pg": "^8.12.0",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.3",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
